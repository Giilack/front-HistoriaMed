# Copie como .env.local para probar en local. Sin esta variable no se muestra el CAPTCHA.
# Clave pública (Site Key) de Cloudflare Turnstile; en Vercel se define en Settings → Environment Variables.
# Clave de prueba de Cloudflare que siempre aprueba: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
